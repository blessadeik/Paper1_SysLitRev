# LaTeX auxiliary files
*.aux
*.log
*.blg
*.bbl
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# macOS
.DS_Store
.AppleDouble

# Office files (not needed in git, keep in project folder)
*.docx
*.xlsx
~$*

# Temporary/backup files
*.tmp
*~
*.swp

# Compiled LaTeX (keep only main.pdf)
*.pdf~

# User prompts and conversation logs
prompts.txt
conversation_log.txt
prompt_history.md

# Working copy of the repo with extra files; important files are copied to source_materials/
Paper 1_full docs and info/

# Keep the review data, protocols and drafts (overrides the *.docx / *.xlsx rules above)
!source_materials/**/*.docx
!source_materials/**/*.xlsx
!review/**/*.docx
!review/**/*.xlsx
